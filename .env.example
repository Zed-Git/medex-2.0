# =============================================================================
# MedEx 2.0 — PRIMER promenljivih okruženja (note.txt: provera ENV)
# =============================================================================
# [DODATO — note.txt] Korak-po-korak za Stripe + Vercel (šta agent ne može umesto tebe):
#   docs/Uputstvo-ENV-Vercel-Stripe.md
#
# Kako koristiti:
#   1) Kopiraj ovaj fajl u `.env.local` (Next.js ga automatski učitava lokalno).
#   2) Popuni prave vrednosti. NIKAD ne commit-uj `.env.local` sa tajnama.
# Na Vercelu: Settings → Environment Variables — iste ključeve, vrednosti za Production/Preview.
#
# VAŽNO — imena koje Next/ovaj projekat ZAISTA koriste:
#   • Supabase URL u kodu je NEXT_PUBLIC_SUPABASE_URL (ne "SUPABASE_URL" bez prefiksa).
#   • Anon ključ je NEXT_PUBLIC_SUPABASE_ANON_KEY (ne "SUPABASE_ANON_KEY" bez prefiksa).
# =============================================================================

# --- Supabase ---
# Javno (browser + server): URL projekta iz Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Javno: "anon" / "public" key (Row Level Security i dalje važi)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SAMO SERVER: service_role key — nikad u client kodu; za API rute koje pišu u DB / Storage
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# KRITIČNO: publishable (pk_*) i tajni ključ (sk_*) moraju biti u ISTOM režimu (oba test ILI oba live).
#   • Lokalno: STRIPE_TEST_SECRET_KEY=sk_test_... + NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_... + STRIPE_WEBHOOK_SECRET_TEST
#   • Vercel Production: STRIPE_SECRET_KEY=sk_live_... + NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... + STRIPE_WEBHOOK_SECRET
# Ako na produkciji ostaneš na pk_test_ uz sk_live_, plaćanje će pucati — terminal/server log će upozoriti.
# Javno: Publishable key (pk_test_... / pk_live_...) za Payment Element na /pay
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server: tajni ključ produkcije (sk_live_...)
STRIPE_SECRET_KEY=
# Server: webhook signing secret iz Stripe Dashboard (produkcija)
STRIPE_WEBHOOK_SECRET=
# Lokalni dev: test tajni ključ (sk_test_...) — u development-u ima prioritet ako je setovan
STRIPE_TEST_SECRET_KEY=
# Lokalni dev: tajna iz `stripe listen` (whsec_...)
STRIPE_WEBHOOK_SECRET_TEST=

# --- Resend (e-pošta) ---
RESEND_API_KEY=
# Opciono: "Ime <email@domen.com>" — mora biti verifikovan domen u Resend
# RESEND_FROM=MedExNews <noreply@medexnews.com>
# Admin primalac / reply u nekim tokovima (javno u bundle-u ako je NEXT_PUBLIC_)
NEXT_PUBLIC_ADMIN_EMAIL=
# Stari alias u kodu — možeš ostaviti prazno ako koristiš samo NEXT_PUBLIC_ADMIN_EMAIL
# MEDEX_ADMIN_EMAIL=

# --- Admin panel (/admin-zdravko) ---
# PIN za API verify-pin (produkcija: obavezno jak PIN)
MEDEX_ADMIN_DASHBOARD_PIN=
# Opciono: e-pošta pomoći prikazana u admin UI
# NEXT_PUBLIC_ADMIN_HELP_EMAIL=

# --- URL-ovi (razlikuju se namerno — pročitaj komentar) ---
# Javni "brend" / SEO / canonical / Open Graph (npr. https://www.medexnews.com)
# Ako nije setovano, u kodu postoji fallback domen (vidi src/lib/site-url.ts).
NEXT_PUBLIC_SITE_URL=

# Baza URL-a SAMOG Next.js app-a: Stripe return_url, linkovi u mejlovima ka tvojoj Vercel aplikaciji.
# Na Vercelu: ako OVO ne postaviš, koristi se automatski VERCEL_URL (https://xxx.vercel.app).
# Postavi eksplicitno ako imaš custom domen SAMO za Next (npr. https://app.medexnews.com).
# Ako Next preuzima ceo domen (tvoj slučaj): stavi ISTO kao NEXT_PUBLIC_SITE_URL (npr. https://www.medexnews.com).
NEXT_PUBLIC_APP_URL=
# Rezervni alias iste namene (niži prioritet od NEXT_PUBLIC_APP_URL)
# Lokalno: http://localhost:3000 je u redu.
# Na Vercelu (Production): NE ostavljaj localhost — obriši ovaj red ili stavi pun HTTPS URL Next aplikacije (ili koristi samo NEXT_PUBLIC_APP_URL).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Cloudflare Turnstile CAPTCHA ---
# [DODATO — Turnstile] Javni site key (NEXT_PUBLIC_) — koristi se u React widgetu na klijentskoj strani
# Dobiti na: https://dash.cloudflare.com → Turnstile → Add site
# Ostavi prazno za lokalni dev (forma radi bez CAPTCHA-e — graceful degradation)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=   # Cloudflare Turnstile Site Key (javni)
# [DODATO — Turnstile] Tajni server key — koristi se SAMO na serveru za verifikaciju tokena
# NIKAD ne commit-uj stvarnu vrijednost! Dodaj u Vercel → Settings → Environment Variables.
TURNSTILE_SECRET_KEY=             # Cloudflare Turnstile Secret Key (samo server)

# --- Google Analytics 4 ---
# Measurement ID iz GA4 Dashboard → Admin → Data Streams → tvoj web stream → Measurement ID (G-XXXXXXXXXX)
# Postavi u Vercel → Settings → Environment Variables → Production (i Preview ako želiš).
# Lokalno OSTAVI PRAZNO ili ukloni — GA neće raditi u dev-u (poželjno ponašanje).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Opciono: Google Search Console (meta verifikacija) ---
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Napomena o VERCEL_URL ---
# Na Vercelu Next automatski postavlja VERCEL_URL (bez tvog unosa).
# Koristi ga getNextAppPublicUrl() kao fallback — zato "BASE_URL" na Vercelu često NE moraš ručno menjati,
# osim ako želiš uvek isti kanonski URL u mejlovima (preporuka: postavi NEXT_PUBLIC_APP_URL na produkcijski HTTPS).
